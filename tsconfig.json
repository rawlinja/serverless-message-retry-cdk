{"$schema": "https://json.schemastore.org/tsconfig",
  "_version": "22.0.0",
  "compilerOptions": {
    "lib": [
      "es2024",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Iterator"
    ],
    "module": "nodenext",
    "target": "es2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "nodenext",
    "rootDir": "./src",
    "outDir": "./dist",
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": false,
    "typeRoots": [
      "./node_modules/@types"
    ],
    "baseUrl": ".",
    "paths": {
      "/opt/nodejs/node_modules/*": ["node_modules/*"],
      "@lib/*": ["src/lib/*"],
      "@stacks/*": ["src/Infrastructure/stacks/*"]
    }
  },
  "exclude": ["node_modules", "cdk.out", "dist/**/*"]
}
